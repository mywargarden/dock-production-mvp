{
  "manifest_version": 3,
  "name": "Dock",
  "description": "Save tabs with context and screenshots. Dock them safely so you can return anytime.",
  "version": "0.3.13",
  "key": "",
  "permissions": ["storage","unlimitedStorage","tabs","activeTab","alarms","identity","identity.email"],
  "host_permissions": ["<all_urls>","https://dock-production-mvp.vercel.app/*","https://mcqohghghfxtchxpaddj.supabase.co/*","https://*.supabase.co/*","https://accounts.google.com/*"],
  "action": {"default_popup":"popup.html","default_icon":{"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}},
  "background": {"service_worker":"background-v3.js","type":"module"},
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_scripts": [{
    "matches": ["http://*/*","https://*/*"],
    "js": ["floating-dock.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [
    {"resources":["import.html"],"matches":["<all_urls>"]},
    {"resources":["assets/dock_logo_clean.png"],"matches":["http://*/*","https://*/*"]}
  ],
  "storage": {"managed_schema":"managed_storage_schema.json"}
}
